{
  "name": "demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build": "ng build --configuration=production",
    "create_cname": "echo bennyl.im > dist/demo/browser/CNAME",
